# Plantilla versionada de las variables de entorno.
# Copiala a .env.local y completa los valores reales:
#   cp .env.example .env.local
#
# La anon key es publica por diseno (viaja al navegador); la seguridad
# real la dan las politicas de Row Level Security en Supabase. Nunca
# pongas aqui la service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
